# Copie este arquivo para .env e preencha as chaves.
# Sem chaves o projeto ainda roda em MODO DEMONSTRAÇÃO (embeddings
# locais + resposta extractiva), útil para entender o pipeline.

# Obrigatório para embeddings OpenAI e geração com GPT-4o
OPENAI_API_KEY=sk-seu-token-aqui

# Opcional: modelo de embedding (padrão: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Opcional: modelo de geração (padrão: gpt-4o)
OPENAI_LLM_MODEL=gpt-4o

# Alternativa: Voyage AI para embeddings (se definido, substitui OpenAI embeddings)
# VOYAGE_API_KEY=pa-seu-token-aqui
# VOYAGE_EMBEDDING_MODEL=voyage-3

# Alternativa: xAI / Grok como LLM (se definido, substitui o GPT-4o)
# XAI_API_KEY=xai-seu-token-aqui
# XAI_LLM_MODEL=grok-3

# Alternativa: Cursor como LLM (Dashboard → Integrations / API Keys).
# Não serve para embeddings — só para a etapa de geração.
# CURSOR_API_KEY=cursor-seu-token-aqui
# CURSOR_LLM_MODEL=composer-2.5
